# IntentFlow V4.5 Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# LLM API Keys (for debate synthesis)
# =============================================================================
# Required for Agent Debate Protocol
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Alternative LLM providers
# ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================================================
# Data Sources
# =============================================================================
# Primary data source: 'parquet' (use existing files) or 'nse_live' (fetch from NSE)
DATA_SOURCE=parquet

# =============================================================================
# Model Configuration
# =============================================================================
# Which version to use: 'v3' (monolithic) or 'v45' (council of experts)
MODEL_VERSION=v45

# Debate synthesis model (cost vs quality tradeoff)
# Options: gpt-4o-mini (cheap), gpt-4o (better), gpt-4-turbo (best)
DEBATE_LLM_MODEL=gpt-4o-mini

# =============================================================================
# Agent Configuration
# =============================================================================
# Risk agent veto threshold (0-1, higher = more conservative)
RISK_VETO_THRESHOLD=0.7

# Enable/disable specific agents
ENABLE_TECHNICAL_ANALYST=true
ENABLE_FLOW_DETECTIVE=true
ENABLE_REGIME_SENTINEL=true
ENABLE_RISK_CONTRARIAN=true
ENABLE_EARNINGS_ORACLE=true

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Optional: Database Connections (for future memory system)
# =============================================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# TIMESCALE_HOST=localhost
# TIMESCALE_PORT=5432
# TIMESCALE_DB=intentflow_deep_memory
